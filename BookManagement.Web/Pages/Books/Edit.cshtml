@page
@model BookManagement.Web.Pages.Books.EditModel

<h1>Edit Book</h1>

<form method="post">

    <input asp-for="Id" type="hidden" />

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
    </div>

    <div>
        <label asp-for="Author"></label>
        <input asp-for="Author" />
    </div>

    <div>
        <label asp-for="ISBN"></label>
        <input asp-for="ISBN" />
    </div>

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" />
    </div>

    <div>
        <label asp-for="PublishedDate"></label>
        <input asp-for="PublishedDate" type="date" />
    </div>

    <button type="submit">Save Changes</button>

    <a asp-page="Index">Cancel</a>

</form>